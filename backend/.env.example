# Copiar a .env y completar. Nunca commitear .env.
APP_NAME="LifeOS API"
ENVIRONMENT=development
DEBUG=false

# mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
# Si la contraseña tiene caracteres especiales (@ : / #), codificalos en URL (ej. @ → %40).
DATABASE_URL=mysql+pymysql://lifeos:CAMBIAR_CONTRASEÑA@localhost:3306/lifeos?charset=utf8mb4
