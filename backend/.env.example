# Copiar a .env y completar. Nunca commitear .env.
APP_NAME="LifeOS API"
ENVIRONMENT=development
DEBUG=false

# mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
# Si la contraseña tiene caracteres especiales (@ : / #), codificalos en URL (ej. @ → %40).
DATABASE_URL=mysql+pymysql://lifeos:CAMBIAR_CONTRASEÑA@localhost:3306/lifeos?charset=utf8mb4

# Orígenes del frontend autorizados a llamar a la API (lista JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Clave para firmar las sesiones (mínimo 32 caracteres). Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR
# Días que dura una sesión antes de pedir login de nuevo
ACCESS_TOKEN_DAYS=30
